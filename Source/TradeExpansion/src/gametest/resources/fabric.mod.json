		]
	},
	"mixins": [
		{
			"config": "ak_trade_expansion_test.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"ak_trade_expansion": "*",
		"fabric-gametest-api-v1": "*",
		"fabric-client-gametest-api-v1": "*"
	}
}
