{
	"schemaVersion": 1,
	"id": "ak_trade_expansion_test",
	"version": "${version}",
	"name": "AK Trade Expansion automated tests",
	"description": "Automated checks of docs/release/ingame-checklist.md (development only, not distributed).",
	"license": "LGPL-2.1-only",
	"environment": "*",
	"entrypoints": {
		"fabric-gametest": [
			"com.akf.tradeexpansion.test.server.ServerChecklistTests"
